    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2"
  },
  "files": [
    "dist",
    "drizzle"
