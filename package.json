{
  "name": "aquarium",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p e2e/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "smoke": "node tools/smoke/smoke.mjs",
    "build": "pnpm -r --if-present build",
    "build:assets": "node --import ./tools/asset-pipeline/src/ts-resolve.mjs tools/asset-pipeline/src/cli.ts build",
    "assets:sync-manifest": "node --import ./tools/asset-pipeline/src/ts-resolve.mjs tools/asset-pipeline/src/cli.ts sync-manifest",
    "assets:check": "node --import ./tools/asset-pipeline/src/ts-resolve.mjs tools/asset-pipeline/src/cli.ts check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "nodemailer": "10.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
